{
  "schema_version": 2,
  "runtime_abi": 1,
  "id": "exe-packager-toolkit",
  "name": "EXE Packager Toolkit",
  "version": "0.1.1",
  "description": "One-time approved, workspace-confined Windows one-file EXE packager with fixed Python/PyInstaller, Go and .NET toolchain profiles; no shell or arbitrary commands.",
  "entrypoint": "plugin.py",
  "permissions": [
    "workspace.read",
    "workspace.write",
    "process.execute:python.exe",
    "process.execute:py.exe",
    "process.execute:go.exe",
    "process.execute:dotnet.exe"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 90
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
    "status": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "mutation_scope": {
        "mode": "none"
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      },
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "preflight": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "timeout_seconds": 90,
      "mutation_scope": {
        "mode": "none"
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1024
          },
          "output_dir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "output_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "backend": {
            "type": "string",
            "enum": [
              "auto",
              "python",
              "go",
              "dotnet"
            ],
            "default": "auto"
          }
        },
        "required": [
          "source_path",
          "output_dir",
          "output_name"
        ],
        "additionalProperties": false
      }
    },
    "package-onefile": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "job",
      "timeout_seconds": 0,
      "mutation_scope": {
        "mode": "workspace"
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "job_owned"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1024
          },
          "output_dir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "output_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "backend": {
            "type": "string",
            "enum": [
              "auto",
              "python",
              "go",
              "dotnet"
            ],
            "default": "auto"
          },
          "gui": {
            "type": "boolean",
            "default": true
          },
          "expected_source_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          },
          "expected_output_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 7200,
            "default": 3600
          }
        },
        "required": [
          "source_path",
          "output_dir",
          "output_name",
          "expected_source_sha256"
        ],
        "additionalProperties": false
      }
    },
    "verify-exe": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "timeout_seconds": 60,
      "mutation_scope": {
        "mode": "none"
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1024
          },
          "expected_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  }
}
