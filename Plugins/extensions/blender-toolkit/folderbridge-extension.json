{
  "schema_version": 2,
  "runtime_abi": 1,
  "id": "blender-toolkit",
  "name": "Blender Toolkit",
  "version": "0.1.2",
  "description": "Global live Blender 5.x control bridge for FolderBridge with broad declarative scene/RNA, object, mesh, collection, modifier, constraint, node-tree, animation, safe-operator, file and render actions; arbitrary Python/shell execution is intentionally not exposed.",
  "entrypoint": "plugin.py",
  "permissions": [
    "network.loopback:127.0.0.1:8766",
    "workspace.read",
    "workspace.write",
    "process.execute:blender.exe"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 60
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
    "status": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "run_mode": "foreground",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "launch-ui": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "foreground",
      "input_schema": {
        "type": "object",
        "properties": {
          "blend_path": {
            "type": "string",
            "maxLength": 1024,
            "default": ""
          },
          "wait_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 30,
            "default": 15
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "foreground"
      }
    },
    "inspect-context": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "foreground",
      "input_schema": {
        "type": "object",
        "properties": {
          "include_addons": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "list-data": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "foreground",
      "input_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "objects",
              "collections",
              "materials",
              "meshes",
              "curves",
              "cameras",
              "lights",
              "armatures",
              "actions",
              "images",
              "node_groups",
              "worlds",
              "scenes"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "additionalProperties": false,
        "required": [
          "kind"
        ]
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "inspect-data": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "foreground",
      "input_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "object",
              "collection",
              "material",
              "mesh",
              "curve",
              "camera",
              "light",
              "armature",
              "action",
              "image",
              "node_group",
              "world",
              "scene"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "properties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "name"
        ]
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "screenshot": {
      "read_only": true,
