{
  "schema_version": 2,
  "runtime_abi": 1,
  "id": "comfyui",
  "name": "Local ComfyUI",
  "version": "1.6.0",
  "description": "External hot-load bridge to local ComfyUI at 127.0.0.1:8188. Long workflow runs execute as host-owned jobs; bounded control actions expose memory release, real ComfyUI job state, exact progress observation, reusable read-only health snapshots, targeted cancellation, node/model capability discovery, transient history retry, and fail-closed reusable production preflight profiles without arbitrary HTTP access.",
  "entrypoint": "plugin.py",
  "permissions": [
    "network.loopback:127.0.0.1:8188",
    "workspace.read",
    "workspace.write"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 600
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
    "status": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "free": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 15,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "unload_models": {
            "type": "boolean",
            "default": true
          },
          "free_memory": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "foreground"
      }
    },
    "jobs": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 10,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "created_at",
              "execution_duration"
            ],
            "default": "created_at"
          },
          "sort_order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "job-status": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 10,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          }
        },
        "required": [
          "prompt_id"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "progress": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 15,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observe_seconds": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10,
            "default": 2
          }
        },
        "required": [
          "prompt_id"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "health-check": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 25,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          }
        },
        "required": [
          "prompt_id"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "cancel-prompt": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 10,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          }
        },
        "required": [
          "prompt_id"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "foreground"
      }
    },
    "node-info": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 10,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "class_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "class_name"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "models": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 10,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "contains": {
            "type": "string",
            "maxLength": 256
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "features": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "timeout_seconds": 10,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "preflight": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "timeout_seconds": 25,
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "workflow_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "production_profile": {
            "type": "string",
            "enum": [
              "auto",
              "none",
              "minimax_h3_v2v_16gb_1344x768"
            ],
            "default": "auto"
          }
        },
        "required": [
          "workflow_path"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "run": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "job",
      "timeout_seconds": 0,
      "mutation_scope": {
        "mode": "paths",
        "claims": [
          {
            "param": "save_directory",
            "kind": "tree",
            "optional": true
          }
        ]
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "workflow_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "production_profile": {
            "type": "string",
            "enum": [
              "auto",
              "none",
              "minimax_h3_v2v_16gb_1344x768"
            ],
            "default": "auto"
          },
          "save_directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 7200
          }
        },
        "required": [
          "workflow_path"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "job_owned"
      }
    }
  }
}
