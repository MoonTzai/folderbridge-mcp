{
  "schema_version": 1,
  "id": "comfyui",
  "name": "Local ComfyUI",
  "version": "1.3.0",
  "description": "External hot-load bridge to local ComfyUI at 127.0.0.1:8188. Long workflow runs execute as host-owned jobs, use prompt-scoped cancellation, preflight supported dynamic inputs, and return bounded artifact paths/metadata without embedding generated media by default.",
  "entrypoint": "plugin.py",
  "permissions": [
    "network.loopback:127.0.0.1:8188",
    "workspace.read",
    "workspace.write"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 600
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
    "status": {
      "read_only": true,
      "requires_workspace": false,
      "authorization": "global",
      "mutation_scope": {
        "mode": "none"
      },
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "run": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "job",
      "timeout_seconds": 0,
      "mutation_scope": {
        "mode": "paths",
        "claims": [
          {
            "param": "save_directory",
            "kind": "tree",
            "optional": true
          }
        ]
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "workflow_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "save_directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 7200
          }
        },
        "required": ["workflow_path"],
        "additionalProperties": false
      }
    }
  }
}
