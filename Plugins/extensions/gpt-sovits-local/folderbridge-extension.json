{
  "schema_version": 2,
  "runtime_abi": 1,
  "id": "gpt-sovits-local",
  "name": "Local GPT-SoVITS",
  "version": "0.2.2",
  "description": "Workspace-confined GPT-SoVITS v2Pro toolkit with dedicated runtime/model inspection, audio analysis/slicing, ASR, dataset preparation, training, single/batch inference, WebUI/API service lifecycle, artifact receipts, and a deprecated compatibility run action. It invokes only the fixed GPT-SoVITS-Bridge runner.",
  "entrypoint": "plugin.py",
  "permissions": [
    "workspace.read",
    "workspace.write",
    "extension.state",
    "process.execute:powershell.exe",
    "network.loopback:127.0.0.1:9874",
    "network.loopback:127.0.0.1:9880",
    "network.outbound:https"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 600
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
