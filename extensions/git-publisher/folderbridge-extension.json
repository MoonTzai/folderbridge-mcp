{
  "schema_version": 1,
  "id": "git-publisher",
  "name": "Git Publisher",
  "version": "1.3.0",
  "description": "Safely connect GitHub in a browser, commit explicit files, push only the current branch, publish the locked FolderBridge release, or publish explicit Release assets from the selected GitHub repository.",
  "entrypoint": "plugin.py",
  "permissions": [
    "workspace.read",
    "workspace.write",
    "git.commit-selected-files",
    "git.push-current-branch",
    "github.web-auth",
    "process.execute:git.exe",
    "process.execute:gh.exe"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 600
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
    "status": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "offset": {"type": "integer", "minimum": 0, "default": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 200}
        },
        "additionalProperties": false
      }
    },
    "connect": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {
          "username": {"type": "string", "minLength": 1, "maxLength": 128},
          "force": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    },
    "commit": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 1024},
            "minItems": 1,
            "maxItems": 128
          },
          "message": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "required": ["paths", "message"],
        "additionalProperties": false
      }
    },
    "push": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "release": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "release-assets": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "job",
      "timeout_seconds": 7200,
      "input_schema": {
        "type": "object",
        "properties": {
          "tag": {"type": "string", "minLength": 1, "maxLength": 128},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 1024},
                "name": {"type": "string", "minLength": 1, "maxLength": 255}
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "latest": {"type": "boolean", "default": true}
        },
        "required": ["tag", "title", "assets"],
        "additionalProperties": false
      }
    }
  }
}
