{
  "schema_version": 2,
  "runtime_abi": 1,
  "id": "git-publisher",
  "name": "Git Publisher",
  "version": "1.5.0",
  "description": "Safely operate a selected workspace-root or nested GitHub repository: browser auth, explicit-file commits, current-branch push, and explicit Release assets.",
  "entrypoint": "plugin.py",
  "permissions": [
    "workspace.read",
    "workspace.write",
    "git.commit-selected-files",
    "git.push-current-branch",
    "github.web-auth",
    "process.execute:git.exe",
    "process.execute:gh.exe"
  ],
  "execution": {
    "mode": "isolated-process",
    "timeout_seconds": 600
  },
  "workspace_adapter": {
    "mode": "none",
    "state": "none"
  },
  "actions": {
    "status": {
      "read_only": true,
      "requires_workspace": true,
      "authorization": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 200
          },
          "repo_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "default": "."
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "read_only",
        "lifetime": "foreground"
      }
    },
    "connect": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "force": {
            "type": "boolean",
            "default": false
          },
          "repo_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "default": "."
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "foreground"
      }
    },
    "commit": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 1,
            "maxItems": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "repo_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "default": "."
          }
        },
        "required": [
          "paths",
          "message"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "foreground"
      }
    },
    "push": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "default": "."
          }
        },
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "foreground"
      }
    },
    "release-assets": {
      "read_only": false,
      "requires_workspace": true,
      "authorization": "global",
      "run_mode": "job",
      "timeout_seconds": 7200,
      "input_schema": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "latest": {
            "type": "boolean",
            "default": true
          },
          "repo_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "default": "."
          }
        },
        "required": [
          "tag",
          "title",
          "assets"
        ],
        "additionalProperties": false
      },
      "effect_contract": {
        "effect_semantics": "external_effect",
        "lifetime": "job_owned"
      }
    }
  }
}
